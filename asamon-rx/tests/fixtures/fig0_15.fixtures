# expect = asa-Record, wie asamon-rx ihn schreibt (seq 0, Zeit 0)

name=heartbeat
fib=018fffffffffffffffffffffffffffffffffffffffffffffffffffffffff
expect={"type":"asa","seq":0,"ts":"1970-01-01T00:00:00.000000000Z","heartbeat":true,"cn":true,"oe":false,"pd_second_half":false,"raw":"018f"}

